# Project database (optional). Without it the workbench still runs, but names,
# comments, bookmarks and analysis snapshots are not persisted between sessions.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional LLM provider for the AI panel (the local evidence engine always works).
# Anthropic — official SDK, streaming, adaptive thinking. Either credential works:
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# Any OpenAI-compatible endpoint (OpenAI, llama.cpp, vLLM, LM Studio, Ollama…):
# OPENAI_API_KEY=
# AI_BASE_URL=          # e.g. http://127.0.0.1:8080/v1 — key optional for local servers
# Tuning:
# AI_PROVIDER=          # anthropic | openai — force one when both are configured
# AI_MODEL=             # default claude-opus-5 (Anthropic) / gpt-4o-mini (OpenAI-compatible)
# AI_EFFORT=high        # Anthropic reasoning depth: low | medium | high | xhigh | max
